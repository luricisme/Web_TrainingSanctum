// Training Sanctum — Prisma schema
//
// Story 1.1 scope was the bare `User` model (skeleton) needed to prove the
// Prisma wiring end-to-end. Story 1.2 wires Better Auth (email/password)
// against this schema: `Session`/`Account`/`Verification` are Better Auth's
// required tables (field names/shapes mirror its core schema exactly — see
// apps/web/lib/auth.ts), and `User.timezone` is the one custom field this
// story adds, captured client-side at signup (AD-8). Card, Folder, and
// SchedulingRecord land in Epic 2+ per the architecture spine. AD-2: Postgres
// is reachable only through the client exported by this package — no other
// package instantiates PrismaClient or issues raw SQL.

generator client {
  provider     = "prisma-client"
  output       = "./generated/client"
  moduleFormat = "esm"
}

// Prisma 7 removed `url` from the datasource block — the connection string
// now lives in prisma.config.ts (CLI/migrate) and is passed to PrismaClient
// via a driver adapter at runtime (see client.ts).
datasource db {
  provider = "postgresql"
}

// Better Auth's base User fields (name, email, emailVerified, image,
// timestamps) plus the custom `timezone` field (Design Notes / AD-8).
// Note: the hashed password itself is NOT stored on this model — Better
// Auth's email/password provider stores it on the related `Account` row
// (providerId: "credential"), which is where its own sign-in/verify logic
// reads it from. See Implementation Notes in spec-1-2 for why the earlier
// `User.hashedPassword` placeholder field was dropped instead of kept as an
// unused/hand-synced column.
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  timezone      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  classes  Class[]
  folders    Folder[]
  flashcards Flashcard[]
  cards      Card[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// Story 2.1: the Class -> Folder -> Card hierarchy. Every row carries `userId`
// so each query can be scoped to the session user. Deletes cascade down the
// tree. The "one Unsorted Folder per Class" rule is a partial unique index on
// `folders("classId") WHERE "isUnsorted"`, which Prisma cannot express, so it
// lives as raw SQL at the end of the add_class_folder_card migration.
model Class {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folders Folder[]

  @@index([userId, name])
  @@map("classes")
}

model Folder {
  id         String   @id @default(cuid())
  name       String
  isUnsorted Boolean  @default(false)
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  flashcards Flashcard[]

  @@index([classId])
  @@index([userId])
  @@map("folders")
}

// Story 2.7: a named set of Cards inside one Folder. The unique name per Folder
// (case-insensitive) is a raw SQL index on `flashcards("folderId", lower("name"))`
// in the add_flashcard migration, which Prisma cannot express.
model Flashcard {
  id        String   @id @default(cuid())
  name      String
  folderId  String
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards Card[]

  @@index([folderId])
  @@index([userId])
  @@map("flashcards")
}

model Card {
  id           String   @id @default(cuid())
  term         String
  definition   String
  example      String?
  context      String?
  partOfSpeech String?
  flashcardId  String
  flashcard    Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schedulingRecords SchedulingRecord[]

  @@index([flashcardId])
  @@index([userId])
  @@map("cards")
}

enum RecallDirection {
  TERM_TO_DEFINITION
  DEFINITION_TO_TERM
}

// Schema only in Story 2.1: nothing writes these rows until Story 2.3.
model SchedulingRecord {
  id             String          @id @default(cuid())
  cardId         String
  card           Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  direction      RecallDirection
  interval       Int             @default(0)
  repetitions    Int             @default(0)
  easeFactor     Float           @default(2.5)
  nextReviewDate DateTime
  /// AD-14: set once, by the grade route, on this record's first grade.
  /// Records graded before the 20261113 migration were backfilled with
  /// `updatedAt` (their last write), so for them it is only an approximation.
  firstGradedAt  DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([cardId, direction])
  @@index([nextReviewDate])
  @@map("scheduling_records")
}
