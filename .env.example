# Copy to .env.local for local development (never commit the real file).
# Validated at process start by apps/web/lib/env.ts — the app fails fast
# with a clear error if these are missing or malformed.

# Postgres connection string (Neon dev/preview/production branch).
# Example: postgresql://user:password@ep-example-123456.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Session/auth secret (wired up by Better Auth in story 1.2).
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional — Better Auth's base URL. Recommended behind a proxy/CDN
# (e.g. Vercel) so callback/redirect URLs aren't derived from a spoofable
# forwarded header; not required for story 1.2's email/password flow.
# BETTER_AUTH_URL=http://localhost:3000

# Optional — defaults to "development" if unset (see apps/web/lib/env.ts).
# NODE_ENV=development
